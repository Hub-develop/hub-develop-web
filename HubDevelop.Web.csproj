<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HubDevelop.Web</RootNamespace>
    <AssemblyName>HubDevelop.Web</AssemblyName>

    <!-- 自定义域名 hub-develop.top 部署在根路径 -->
    <BaseHref>/</BaseHref>

    <!-- AOT 编译：Blazor WebAssembly 的 AOT（用户要求）。CI 通过 wasm-tools workload 实现。 -->
    <WasmEnableAot>true</WasmEnableAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
    <!--
      Byta.GL 真实 WebGL 背景（Byta.Browser 后端）等其发 0.2.0（含浏览器后端）上 NuGet 后再引用。
      当前用 WebGLAurora（真 WebGL GLSL 极光）兜底，接入说明见 Rendering/BytaGLBackground.cs。
    -->
  </ItemGroup>

</Project>
