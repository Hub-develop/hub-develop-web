<div class="fab">
    @if (_open)
    {
        <div class="fab__panel">
            <a class="fab__link" href="https://xlord.hub-develop.top" target="_blank" rel="noopener noreferrer">xlord.hub-develop.top</a>
            <a class="fab__link" href="https://code.hub-develop.top" target="_blank" rel="noopener noreferrer">code.hub-develop.top</a>
            <a class="fab__link" href="https://github.com/Hub-develop" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
    }

    <button class="fab__btn" type="button" @onclick="Toggle" aria-label="链接子域名">
        @if (_open)
        {
            <span class="fab__glyph">×</span>
        }
        else
        {
            <span class="fab__glyph">≡</span>
        }
    </button>
</div>

@code {
    private bool _open;

    private void Toggle() => _open = !_open;
}
